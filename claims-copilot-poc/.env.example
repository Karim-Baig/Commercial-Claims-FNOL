# ---------------------------------------------------------------- API
# AUTH_MODE=mock  -> local HS256 token issuer, no Okta tenant required (dev only)
# AUTH_MODE=okta  -> real Okta JWKS validation (production path, NFR-33)
AUTH_MODE=mock
MOCK_JWT_SECRET=poc-local-secret-do-not-use-in-any-real-environment

# Required only when AUTH_MODE=okta
OKTA_ISSUER=https://dev-00000000.okta.com/oauth2/default
OKTA_AUDIENCE=api://default
OKTA_CLIENT_ID=

# ---------------------------------------------------------------- database
# DB_KIND=sqlite -> zero-infra default, runs today
# DB_KIND=mysql  -> production target (NFR-17: InnoDB Cluster + Group Replication)
DB_KIND=sqlite
SQLITE_PATH=./data/poc.sqlite3

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=claims
MYSQL_PASSWORD=claims
MYSQL_DATABASE=claims_poc

# ---------------------------------------------------------------- misc
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CONFIG_DIR=../../config
